{%- comment -%}
  The Dog Nook — Bundle page ("What's inside" layout).

  ⚠️ 2026-08-13 FIX. This section used to render hardcoded section settings, so every
  bundle sharing templates/product.bundle.json wore The First Days Kit's contents, totals,
  headline and badge. The live Settle-In page claimed its parts cost £49.97 (truth £72.97)
  and badged "SAVE £15" (truth £7.98) — a false savings claim under DMCC 2024.

  Everything money-related is now DERIVED FROM THE PRODUCT, never typed in:
    · "bought separately" = product.compare_at_price (that IS the component sum)
    · the saving          = compare_at_price - price, computed
    · heading / eyebrow   = the product's own title
    · contents            = product.metafields.custom.bundle_contents (JSON)
  A bundle with no contents metafield renders no panel rather than someone else's.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cur = product.selected_or_first_available_variant
  assign sep = product.compare_at_price
  assign saving = 0
  if sep > product.price
    assign saving = sep | minus: product.price
  endif
  assign items = product.metafields.custom.bundle_contents.value
  assign stage = product.metafields.custom.stage.value
-%}
<div class="tdn tdn-fade" data-tdn-product>
  <section class="tdn-section tdn-wrap">
    <div class="tdn-pdp">
      <div class="tdn-bundlep__img" style="background: {{ s.image_tone | default: 'linear-gradient(140deg,#c79079,#a86b4f)' }};">
        {%- if product.featured_media -%}
          {%- assign b_alt = product.featured_media.alt | default: product.title | escape -%}
          {{ product.featured_media | image_url: width: 1000 | image_tag: class: 'tdn-bundlep__bg', widths: '500, 750, 1000', alt: b_alt }}
        {%- endif -%}
        {%- if saving > 0 -%}
          <span class="tdn-bundlep__badge">SAVE {{ saving | money }}</span>
        {%- endif -%}
        {%- if product.featured_media == blank -%}<span class="tdn-bundlep__ph">{{ product.title }}</span>{%- endif -%}
      </div>

      <div class="tdn-bundlep__body">
        {%- if stage != blank -%}
          <div class="tdn-eyebrow tdn-bundlep__stage">{{ stage }}</div>
        {%- elsif s.eyebrow != blank -%}
          <div class="tdn-eyebrow">{{ s.eyebrow }}</div>
        {%- endif -%}

        <h1 class="tdn-h1 tdn-bundlep__h1">{{ product.title }}</h1>

        {%- if product.description != blank -%}
          <div class="tdn-bundlep__intro tdn-rte">{{ product.description }}</div>
        {%- elsif s.intro != blank -%}
          <p class="tdn-bundlep__intro">{{ s.intro }}</p>
        {%- endif -%}

        {%- if items != blank and items.size > 0 -%}
          <div class="tdn-bundlep__panel">
            <div class="tdn-bundlep__panel-label">{{ s.panel_label | default: "What's inside" }}</div>
            {%- for it in items -%}
              <div class="tdn-bundlep__row">
                <div class="tdn-bundlep__swatch" style="background: {{ it.tone | default: '#C89178' }};"></div>
                <div class="tdn-bundlep__rowbody">
                  <div class="tdn-bundlep__rowname">{{ it.name }}</div>
                  <div class="tdn-bundlep__rownote">{{ it.note }}</div>
                </div>
                <div class="tdn-bundlep__rowprice">{{ it.price }}</div>
              </div>
            {%- endfor -%}
            {%- if sep > product.price -%}
              <div class="tdn-bundlep__sep"><span>Bought separately</span><span class="tdn-strike">{{ sep | money }}</span></div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="tdn-bundlep__prices">
          <span class="tdn-price tdn-bundlep__price" data-tdn-price>{{ cur.price | money }}</span>
          {%- if saving > 0 -%}
            <span class="tdn-badge">You save {{ saving | money }}</span>
          {%- endif -%}
        </div>

        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ cur.id }}">
          <button type="submit" class="tdn-btn tdn-btn--primary tdn-btn--block tdn-bundlep__atc" data-tdn-atc data-add-label="{{ s.button_label | default: 'Add bundle to basket' }}" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}{{ s.button_label | default: 'Add bundle to basket' }}{%- else -%}Sold out{%- endif -%}
          </button>
        {%- endform -%}

        {% render 'dog-nook-trust-panel', returns_text: '30-day money-back guarantee' %}
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
  .tdn-pdp { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  @media (max-width: 760px) { .tdn-pdp { grid-template-columns: 1fr; gap: 24px; } }
  .tdn-bundlep__img { position: relative; border-radius: 20px; min-height: 460px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .tdn-bundlep__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tdn-bundlep__badge { position: absolute; top: 16px; left: 16px; background: var(--tdn-charcoal); color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .4px; padding: 7px 12px; border-radius: 999px; white-space: nowrap; }
  .tdn-bundlep__ph { font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,.85); font-weight: 600; text-align: center; padding: 0 20px; }
  .tdn-bundlep__body { display: flex; flex-direction: column; justify-content: center; }
  .tdn-bundlep__h1 { font-size: 32px; line-height: 1.12; }
  .tdn-bundlep__stage { color: var(--tdn-sage); }
  .tdn-bundlep__intro { font-size: 15px; line-height: 1.7; color: var(--tdn-muted-2); margin: 0 0 20px; }
  .tdn-bundlep__intro p { margin: 0 0 10px; }
  .tdn-bundlep__panel { background: var(--tdn-panel); border: 1px solid var(--tdn-card-border); border-radius: 16px; padding: 20px; margin-bottom: 20px; }
  .tdn-bundlep__panel-label { font-size: 12px; letter-spacing: .6px; text-transform: uppercase; color: var(--tdn-faint); font-weight: 600; margin-bottom: 14px; }
  .tdn-bundlep__row { display: flex; align-items: center; gap: 14px; padding: 10px 0; border-bottom: 1px solid #eee2d0; }
  .tdn-bundlep__swatch { width: 46px; height: 46px; border-radius: 10px; flex-shrink: 0; }
  .tdn-bundlep__rowbody { flex: 1; }
  .tdn-bundlep__rowname { font-weight: 600; font-size: 14.5px; }
  .tdn-bundlep__rownote { font-size: 12.5px; color: var(--tdn-faint); }
  .tdn-bundlep__rowprice { font-weight: 600; font-size: 14px; color: var(--tdn-muted-2); }
  .tdn-bundlep__sep { display: flex; justify-content: space-between; align-items: center; padding-top: 14px; font-size: 13.5px; color: var(--tdn-faint); }
  .tdn-strike { text-decoration: line-through; }
  .tdn-bundlep__prices { display: flex; align-items: baseline; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
  .tdn-bundlep__price { font-size: 32px; }
  .tdn-bundlep__atc { padding: 15px; font-size: 15px; margin-bottom: 14px; }
  @media (max-width: 760px) { .tdn-bundlep__img { min-height: 300px; } .tdn-bundlep__h1 { font-size: 26px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "TDN Bundle page",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Price, savings, heading and contents all come from the PRODUCT (compare-at price + custom.bundle_contents + custom.stage). Nothing money-related is typed here — that is what caused every bundle to wear the First Days Kit's numbers." },
    { "type": "text", "id": "eyebrow", "label": "Fallback eyebrow (used only if custom.stage is unset)" },
    { "type": "textarea", "id": "intro", "label": "Fallback intro (used only if the product has no description)" },
    { "type": "text", "id": "panel_label", "label": "Panel label", "default": "What's inside" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add bundle to basket" },
    { "type": "text", "id": "image_tone", "label": "Placeholder colour / gradient (CSS)", "default": "linear-gradient(140deg,#c79079,#a86b4f)" }
  ],
  "presets": [ { "name": "TDN Bundle page" } ]
}
{% endschema %}
