<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" href="{{ settings.favicon | image_url: width: 48 }}">
  {%- else -%}
    <link rel="icon" href="{{ 'logo.svg' | asset_url }}" type="image/svg+xml">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  {% render 'catwalk-fonts' %}
  {{ 'catwalk.css' | asset_url | stylesheet_tag }}

  {% render 'structured-data' %}
  {{ content_for_header }}
  <script src="{{ 'catwalk.js' | asset_url }}" defer></script>
  <script src="{{ 'motion.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ template.name }}">
  <a class="skip" href="#main">Skip to content</a>
  {% section 'announcement' %}
  {% section 'header' %}
  {% section 'sale-ticker' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% section 'cart-drawer' %}
  {% section 'offer-popup' %}
  {% render 'chat-fab' %}
</body>
</html>
