[
  {
    "name": "theme_info",
    "theme_name": "Catwalk Club",
    "theme_version": "1.0.0",
    "theme_author": "Catwalk Club",
    "theme_documentation_url": "https://github.com/aryancodes420/sc",
    "theme_support_url": "https://github.com/aryancodes420/sc/issues"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "tagline",
        "label": "Footer tagline",
        "default": "Seriously cute costumes for cats. Free UK delivery over £30."
      }
    ]
  },
  {
    "name": "Delivery",
    "settings": [
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free delivery threshold (whole £)",
        "default": "30",
        "info": "Used by the cart progress bar. Must match your real shipping settings."
      },
      {
        "type": "text",
        "id": "shipping_cost",
        "label": "Standard delivery cost shown on product pages",
        "default": "£3.95"
      },
      {
        "type": "text",
        "id": "returns_days",
        "label": "Returns window (days)",
        "default": "30"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      }
    ]
  },
  {
    "name": "Contact & chat",
    "settings": [
      {
        "type": "text",
        "id": "contact_email",
        "label": "Contact email",
        "info": "Shown on the contact page, the About page and in structured data."
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "info": "International format without +, e.g. 447700900123. Leave blank to hide WhatsApp."
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Hours",
        "default": "Mon–Fri, 9am–6pm UK time"
      },
      {
        "type": "text",
        "id": "reply_time",
        "label": "Reply time",
        "default": "within one working day"
      },
      {
        "type": "checkbox",
        "id": "show_chat",
        "label": "Show the 'Help me choose' button",
        "default": true,
        "info": "Turn off if you install Shopify Inbox, which adds its own chat button."
      },
      {
        "type": "text",
        "id": "chat_label",
        "label": "Button label",
        "default": "Help me choose"
      },
      {
        "type": "url",
        "id": "contact_page",
        "label": "Contact page"
      },
      {
        "type": "url",
        "id": "size_guide_page",
        "label": "Size guide page"
      }
    ]
  },
  {
    "name": "Orders & stock",
    "settings": [
      {
        "type": "url",
        "id": "tracking_url",
        "label": "Tracking app page",
        "info": "e.g. /apps/parcelpanel or /apps/track123. Leave blank to show the account login and Shop app links instead."
      },
      {
        "type": "text",
        "id": "tracking_param",
        "label": "Tracking app query parameter",
        "default": "nums"
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Show 'Only N left' at or below",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 5
      }
    ]
  }
]
