<div class="wrap">
  {% render 'breadcrumbs' %}
  <section style="padding:20px 0">
    <div class="about-grid">
      <div>
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h1 style="margin-top:14px">{{ section.settings.heading }}</h1>
        <p class="muted" style="font-size:1.12rem">{{ section.settings.lede }}</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:22px">
          <a class="btn" href="{{ routes.all_products_collection_url }}">Shop all</a>
          <a class="btn btn-ghost" href="{{ settings.contact_page | default: '/pages/contact' }}">Say hello</a>
        </div>
      </div>
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" width="800" height="800" loading="lazy">
      {%- endif -%}
    </div>
  </section>
  {%- if section.blocks.size > 0 -%}
    <section style="padding-top:20px">
      <div class="two">
        {%- for block in section.blocks -%}
          <div class="panel" {{ block.shopify_attributes }}><h3>{{ block.settings.emoji }} {{ block.settings.heading }}</h3><p style="margin:0">{{ block.settings.text }}</p></div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
  {%- if page.content != blank -%}
    <section style="padding-top:0"><div class="rte" style="max-width:68ch">{{ page.content }}</div></section>
  {%- endif -%}
  <section style="padding-top:0">
    <div class="callout">
      <h3 style="margin-top:0">Business details</h3>
      <p class="small muted" style="margin:0">{% render 'business-line' %}{% if settings.contact_email != blank %} Email <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>.{% endif %}{% if settings.returns_address != blank or settings.trader_address != blank %} Returns to: {{ settings.returns_address | default: settings.trader_address }}.{% endif %}{% if section.settings.business != blank %} {{ section.settings.business }}{% endif %}</p>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "About" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Costumes made for cats, chosen by someone who has actually tried to dress one." },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Catwalk Club is a small UK shop selling the pieces we would put on our own cats: two everyday collars, four Halloween looks and a Christmas set. Every one is sized from a cat's neck, leaves the face and eyes clear, and comes with the measurements, materials and washing instructions on the page." },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "textarea", "id": "business", "label": "Extra business details (optional)", "info": "The trader name, address and returns address come from Theme settings → Business & returns.", "default": "" }
  ],
  "blocks": [
    { "type": "panel", "name": "Panel", "settings": [
      { "type": "text", "id": "emoji", "label": "Emoji", "default": "🐱" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Why so few" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Because a few good ones beat forty average ones." }
    ] }
  ],
  "presets": [ { "name": "About", "blocks": [
    { "type": "panel", "settings": { "emoji": "🐱", "heading": "Why so few", "text": "Because a few good ones beat forty average ones. Each was picked from a supplier with a long sales record and photos on real cats, then sized, priced and written up from the listing itself. When one earns its place, we add it. When one doesn't sell, it goes." } },
    { "type": "panel", "settings": { "emoji": "📦", "heading": "How orders work", "text": "Stock is held in the UK and dispatched tracked within one working day. Standard delivery is £3.95 and free over £30. If it isn't right, send it back within 30 days, worn or not." } },
    { "type": "panel", "settings": { "emoji": "📏", "heading": "The sizing promise", "text": "Every size on this site is a neck measurement. If you measure, it fits. If it doesn't, the swap is on us." } },
    { "type": "panel", "settings": { "emoji": "📸", "heading": "Your cats", "text": "Tag us or send the photo. The best ones go on the site, with your permission and credit." } }
  ] } ]
}
{% endschema %}
