{%- comment -%} Homepage winners podium. Add a winner block only when it's real; with no blocks the section is hidden outside the editor. {%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<section style="padding-top:0">
  <div class="wrap">
    <div class="sec-head"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div>{% if section.settings.link != blank %}<a class="btn btn-ghost btn-sm" href="{{ section.settings.link }}">Enter this month &rarr;</a>{% endif %}</div>
    {%- if section.blocks.size > 0 -%}{% render 'podium', blocks: section.blocks %}{%- else -%}<div class="video-slot">Winners appear here once the first round closes.</div>{%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Winners podium",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cat of the Month winners" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real customers, real cats." },
    { "type": "url", "id": "link", "label": "Competition page" }
  ],
  "blocks": [ { "type": "winner", "name": "Winner", "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "name", "label": "Cat and county", "default": "Mabel (Leeds)" },
    { "type": "text", "id": "month", "label": "Month", "default": "October 2026" }
  ] } ],
  "presets": [ { "name": "Winners podium" } ]
}
{% endschema %}
