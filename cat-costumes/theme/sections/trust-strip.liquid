<div class="strip">
  <div class="wrap">
    <ul class="stats">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><i>{{ block.settings.icon }}</i><span><b>{{ block.settings.text }}</b>{% if block.settings.sub != blank %}<small>{{ block.settings.sub }}</small>{% endif %}</span></li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "Trust strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji", "default": "📦" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery" },
        { "type": "text", "id": "sub", "label": "Small line", "default": "on orders over £30" }
      ]
    }
  ],
  "presets": [ {
    "name": "Trust strip",
    "blocks": [
      { "type": "item", "settings": { "icon": "📦", "text": "Free UK delivery", "sub": "on orders over £30" } },
      { "type": "item", "settings": { "icon": "↩️", "text": "30-day returns", "sub": "worn or not" } },
      { "type": "item", "settings": { "icon": "🏷️", "text": "10% off your first order", "sub": "use code WELCOME10" } }
    ] } ]
}
{% endschema %}
