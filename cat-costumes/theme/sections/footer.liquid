<footer class="site">
  <div class="wrap">
    <div class="fgrid">
      <div>
        <h4>{{ shop.name }}</h4>
        <p class="small muted">{{ settings.tagline }}</p>
        {%- if settings.social_instagram != blank or settings.social_tiktok != blank -%}
          <p class="small">
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}">Instagram</a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%} &nbsp; <a href="{{ settings.social_tiktok }}">TikTok</a>{%- endif -%}
          </p>
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal_note }}</span>
      <span>{{ powered_by_link }}</span>
    </div>
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="payicons svg" aria-label="Payment methods accepted">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payicon' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "legal_note", "label": "Legal note", "default": "All rights reserved." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "presets": [ { "name": "Footer", "blocks": [ { "type": "menu" }, { "type": "menu" }, { "type": "menu" } ] } ]
}
{% endschema %}
