{%- comment -%}
  "Picture it on your cat": five phone frames. Each block is a clip (video file or an image with
  a link); empty slots show a product photo dimmed with "video coming" so the row is honest
  until you've filmed. Pick the collection whose products fill the empty slots.
{%- endcomment -%}
<section style="padding-top:0">
  <div class="wrap">
    <div class="sec-head"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div></div>
    {%- if section.blocks.size == 0 -%}
    <p class="empty-line">No clips yet — the first 10–20 second phone clips of the cats in the products go here the day they are filmed.</p>
    {%- else -%}
    <div class="phones">
      {%- for block in section.blocks limit: 5 -%}
        {%- assign p = block.settings.product -%}
        <figure class="phone" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, controls: true, preload: 'metadata' }}
          {%- elsif block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="" width="300" height="533" loading="lazy">
          {%- endif -%}
          <figcaption>{% if p %}<a href="{{ p.url }}">{{ p.title }}</a>{% endif %}{% if block.settings.caption != blank %} · {{ block.settings.caption }}{% endif %}</figcaption>
        </figure>
      {%- endfor -%}
      {%- assign empties = 5 | minus: section.blocks.size -%}
      {%- if empties > 0 -%}
        {%- assign col = collections[section.settings.collection] -%}
        {%- for p in col.products limit: empties -%}
          <figure class="phone empty">
            {%- if p.images[1] -%}<img src="{{ p.images[1] | image_url: width: 400 }}" alt="" width="300" height="300" loading="lazy">{%- elsif p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="" width="300" height="300" loading="lazy">{%- endif -%}
            <span class="play">&#9654;</span>
            <figcaption>{{ p.title }} · <em>video coming</em></figcaption>
          </figure>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Picture it on your cat",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Picture it on your cat" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Ten-second clips, phone-shot. Tap to play." },
    { "type": "collection", "id": "collection", "label": "Products to show in empty slots" }
  ],
  "blocks": [ { "type": "clip", "name": "Clip", "settings": [
    { "type": "video", "id": "video", "label": "Video (portrait, 10–20 s)" },
    { "type": "image_picker", "id": "image", "label": "Or a still" },
    { "type": "product", "id": "product", "label": "Product shown" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Kingsley, Leeds" }
  ] } ],
  "presets": [ { "name": "Picture it on your cat" } ]
}
{% endschema %}
