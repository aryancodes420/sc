<section style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subheading }}</p>
      </div>
    </div>
    <div class="grid-p">
      {%- assign col = collections[section.settings.collection] -%}
      {%- for product in col.products limit: section.settings.count -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="muted">Pick a collection for this section in the theme editor.</p>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The ones everyone orders first." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [ { "name": "Featured products" } ]
}
{% endschema %}
