<section style="padding-top:0">
  <div class="wrap">
    <div class="finder" style="display:flex;gap:20px;flex-wrap:wrap;align-items:center;justify-content:space-between">
      <div><h2 style="margin-bottom:.2em">{{ section.settings.heading }}</h2><p class="muted" style="margin:0">{{ section.settings.text }}</p></div>
      {%- if section.settings.url != blank -%}<a class="btn" href="{{ section.settings.url }}">{{ section.settings.button }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Call-out band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure which one?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Three questions: occasion, what your cat will put up with, neck size. Sixty seconds." },
    { "type": "text", "id": "button", "label": "Button", "default": "Take the quiz" },
    { "type": "url", "id": "url", "label": "Link" }
  ],
  "presets": [ { "name": "Call-out band" } ]
}
{% endschema %}
