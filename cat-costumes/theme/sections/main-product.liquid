{%- comment -%}
  Product page, stacked in this order:
    1  hero gallery        2  product (title, price, variants)
    3  add to cart + dynamic checkout (Shop Pay / Apple Pay / Google Pay)
    4  lifestyle videos    5  reviews (app block, e.g. Judge.me)
    6  description & dimensions
{%- endcomment -%}
{%- assign motif = product.metafields.custom.motif | default: '' -%}
{%- assign has_photos = false -%}
{%- if product.images.size > 0 -%}{%- assign has_photos = true -%}{%- endif -%}
{%- assign videos = product.media | where: 'media_type', 'video' -%}
{%- assign ext_videos = product.media | where: 'media_type', 'external_video' -%}
{%- assign size_notes = product.metafields.custom.size_notes | newline_to_br | split: '<br />' -%}
{%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
{%- assign sup_count = product.metafields.custom.supplier_review_count | default: 0 | times: 1 -%}
{%- assign sup_rating = product.metafields.custom.supplier_rating | default: 0 | times: 1.0 -%}
{%- assign sup_round = sup_rating | round -%}
{%- assign sup_reviews = product.metafields.custom.supplier_reviews.value | sort: 'stars' | reverse -%}
{%- assign sup_ratings = product.metafields.custom.supplier_ratings.value | sort: 'stars' | reverse -%}
{%- assign rating_val = product.metafields.reviews.rating.value.rating | default: 0 | times: 1.0 -%}
{%- assign rating_round = rating_val | round -%}
{%- assign cv = product.selected_or_first_available_variant -%}
{%- assign low = settings.low_stock_threshold | default: 5 | times: 1 -%}
{%- capture sizes_json -%}[{%- unless product.has_only_default_variant -%}{%- for v in product.variants -%}{"label":{{ v.title | json }},"neck":{{ size_notes[forloop.index0] | strip | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endunless -%}]{%- endcapture -%}

<div class="wrap pdp-stack">
  {% render 'breadcrumbs' %}

  {%- comment -%} 1 · hero gallery {%- endcomment -%}
  <div class="gallery" data-gallery>
    <div class="mainwrap">
      <div class="main" data-gallery-main data-key="{{ product.handle }}" data-motif="{{ motif }}"
           {% unless has_photos %}data-cat-art="{{ product.handle }}" data-art-motif="{{ motif }}"{% endunless %}>
        {%- if has_photos -%}
          <img src="{{ product.featured_image | image_url: width: 1200 }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               width="1200" height="1200" loading="eager">
        {%- endif -%}
      </div>
      {%- if section.settings.draw_url != blank -%}<a class="drawpill" href="{{ section.settings.draw_url }}">📸 {{ section.settings.draw_label }}</a>{%- endif -%}
      <span class="stockpill{% unless cv.available %} out{% endunless %}{% if cv.available and cv.inventory_management == 'shopify' and cv.inventory_quantity > 0 and cv.inventory_quantity <= low %} low{% endif %}" data-stock-pill data-low="{{ low }}">
        <i></i>
        {%- if cv.available -%}
          {%- if cv.inventory_management == 'shopify' and cv.inventory_quantity > 0 and cv.inventory_quantity <= low -%}Only {{ cv.inventory_quantity }} left
          {%- else -%}In stock{% if product.metafields.custom.badge_uk == true %} · UK stock{% endif %}{%- endif -%}
        {%- else -%}Out of stock{%- endif -%}
      </span>
    </div>
    {%- if product.images.size > 1 -%}
      <div class="thumbs" data-gallery-thumbs>
        {%- for image in product.images limit: 6 -%}
          <button type="button" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-full="{{ image | image_url: width: 1200 }}" data-alt="{{ image.alt | escape }}" aria-label="Photo {{ forloop.index }}">
            <img src="{{ image | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} 1b · the three questions every buyer has {%- endcomment -%}
  <div class="objections" data-sizes="{{ sizes_json | escape }}">
    <details class="obj"><summary><i>📏</i><b>{{ section.settings.q1_title }}</b><span class="plus" aria-hidden="true"></span></summary><div class="inner">
      {%- if product.has_only_default_variant -%}
        <p><b>{{ product.metafields.custom.fit | default: section.settings.q1_text }}</b></p><p class="small muted" style="margin:0">No size to pick. <a href="{{ settings.size_guide_page | default: '/pages/fit-and-care' }}">How it fastens</a></p>
      {%- else -%}
        <p>Every size is a <b>neck measurement</b>. Wrap a soft tape where a collar sits, add two fingers, and type the number:</p>
        <div class="mini" data-mini><input type="number" min="10" max="60" step="1" placeholder="neck cm" aria-label="Neck in cm"><button class="btn btn-sm" type="button">Check</button></div><p class="mini-out" data-mini-out></p>
        <p class="small muted" style="margin:0">Between sizes? Take the larger. <a href="{{ settings.size_guide_page | default: '/pages/fit-and-care' }}">How to measure</a></p>
      {%- endif -%}
    </div></details>
    <details class="obj"><summary><i>🚚</i><b>{{ section.settings.q2_title }}</b><span class="plus" aria-hidden="true"></span></summary><div class="inner">
      {%- if product.metafields.custom.no_delivery_dates == true -%}<p><b>Tracked UK delivery</b>, free over £{{ settings.free_shipping_threshold }}.</p>{%- else -%}<p>Order today and it should arrive <b data-delivery-window data-min="2" data-max="4" data-plain="1">in 2–4 working days</b>.</p>{%- endif -%}
      <table class="mini-table"><tr><td>UK standard, tracked</td><td>2–4 working days</td><td>{{ settings.shipping_cost }}</td></tr><tr><td>Orders over £{{ settings.free_shipping_threshold }}</td><td>2–4 working days</td><td><b>Free</b></td></tr></table>
      <p class="small muted" style="margin:.6em 0 0"><a href="{{ section.settings.q2_url | default: '/pages/track-your-order' }}">Track an order</a></p>
    </div></details>
    <details class="obj"><summary><i>🛡️</i><b>{{ section.settings.q3_title }}</b><span class="plus" aria-hidden="true"></span></summary><div class="inner">
      <ul class="deets small">
        {%- if product.metafields.custom.specs != blank -%}<li>{{ product.metafields.custom.specs.value | first }}</li>{%- endif -%}
        <li>Every photo on this page is the product you get, on a real cat</li>
        {%- if product.metafields.custom.care != blank -%}<li>{{ product.metafields.custom.care }}</li>{%- endif -%}
        <li>Not right? <b>{{ settings.returns_days }} days to return it, worn or not</b></li>
      </ul>
      <p class="small muted" style="margin:.6em 0 0"><a href="{{ settings.contact_page | default: '/pages/contact' }}?product={{ product.handle }}">Ask us anything about it</a></p>
    </div></details>
  </div>
  <details class="obj keep"><summary><i>🐱</i><b>Will my cat keep it on?</b><span class="plus" aria-hidden="true"></span></summary><div class="inner"><p>{{ product.metafields.custom.keep_on | default: section.settings.keep_text }}</p><p class="small muted" style="margin:0"><a href="{{ section.settings.q3_url | default: '/pages/faq' }}">More in the FAQ</a></p></div></details>

  {%- comment -%} 2 · product {%- endcomment -%}
  <div class="pdp-head">
    <h1 style="margin-bottom:.15em">{{ product.title }}</h1>
    {%- if product.metafields.custom.alias != blank -%}<span class="alias">aka {{ product.metafields.custom.alias }}</span>{%- endif -%}
    <a class="rating" href="#reviews">
      {%- if rating_count > 0 -%}
        <span class="stars has" aria-hidden="true">{%- for i in (1..5) -%}{%- if i <= rating_round -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span>
        {{ rating_val | round: 1 }} · {{ rating_count }} review{% if rating_count != 1 %}s{% endif %}
      {%- elsif sup_count > 0 -%}
        <span class="stars has" aria-hidden="true">{%- for i in (1..5) -%}{%- if i <= sup_round -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span>
        {{ sup_rating | round: 1 }} · {{ sup_count }} reviews
      {%- else -%}
        <span class="stars" aria-hidden="true">☆☆☆☆☆</span> No reviews yet — be the first
      {%- endif -%}
    </a>
    <div class="headrow">
      {%- if cv.compare_at_price > cv.price -%}
        {%- assign pct = cv.compare_at_price | minus: cv.price | times: 100.0 | divided_by: cv.compare_at_price | round -%}
        <p class="price sale" style="font-size:1.7rem;margin:0" id="price"><span class="now">{{ cv.price | money }}</span><s>{{ cv.compare_at_price | money }}</s><em class="off">Save {{ pct }}%</em></p>
      {%- else -%}
        <p class="price" style="font-size:1.7rem;margin:0" id="price"><span class="now">{{ cv.price | money }}</span></p>
      {%- endif -%}
    </div>
    <p class="saved" data-saved {% unless cv.compare_at_price > cv.price %}hidden{% endunless %}>You've saved {{ cv.compare_at_price | minus: cv.price | money }}</p>
    {%- if cv.compare_at_price > cv.price and settings.sale_ends != blank -%}
      <p class="launchline" data-launchline data-deadline="{{ settings.sale_ends }}">{{ settings.sale_label }}: <span data-ll-price>{{ cv.price | money }}</span> until {{ settings.sale_ends | date: '%a %-d %b' }}, then <span data-ll-list>{{ cv.compare_at_price | money }}</span>.</p>
    {%- endif -%}
    {%- if product.metafields.custom.blurb != blank -%}<p class="muted" style="font-size:1.08rem;margin-top:.5em">{{ product.metafields.custom.blurb }}</p>{%- endif -%}
    {%- if product.metafields.custom.ticks != blank -%}
      <ul class="ticks">{%- for t in product.metafields.custom.ticks.value -%}<li>{{ t }}</li>{%- endfor -%}</ul>
    {%- endif -%}
    {%- if product.metafields.custom.fit != blank -%}<p><span class="fitline">⇔ {{ product.metafields.custom.fit }}</span></p>{%- endif -%}
  </div>

  {%- comment -%} 3 · add to cart + dynamic checkout {%- endcomment -%}
  {%- form 'product', product, id: 'product-form', class: 'pdp-buy', data-size-notes: product.metafields.custom.size_notes -%}
    {%- unless product.has_only_default_variant -%}
      <div class="field">
        <label for="variant-select">{{ product.options.first }}</label>
        <div class="sizes" role="group">
          {%- for variant in product.variants -%}
            <button type="button" class="szbtn" data-variant="{{ variant.id }}"
                    data-available="{{ variant.available }}" data-qty="{% if variant.inventory_management == 'shopify' %}{{ variant.inventory_quantity }}{% endif %}"
                    data-saved="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | money }}{% endif %}"
                    data-price="{{ variant.price | money }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                    data-pct="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}{% endif %}"
                    aria-pressed="{% if variant.id == product.selected_or_first_available_variant.id %}true{% else %}false{% endif %}"
                    {% unless variant.available %}disabled title="Sold out"{% endunless %}>{{ variant.title }}</button>
          {%- endfor -%}
        </div>
        <p class="small" data-size-note style="margin:.6em 0 0"></p>
        <select id="variant-select" name="id" class="visually-hidden" aria-hidden="true" tabindex="-1">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>
          {%- endfor -%}
        </select>
        <p class="small muted" style="margin:.4em 0 0">Sizes are neck measurements.
          <a href="{{ section.settings.size_guide_url | default: '/pages/fit-and-care' }}">How to measure</a></p>
      </div>
    {%- else -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {%- endunless -%}

    {%- comment -%} Pay in 3 / Klarna etc. — Shopify renders this only when an instalment provider is enabled {%- endcomment -%}
    <div class="instal-wrap">{{ form | payment_terms }}</div>
    <div class="buyrow">
      <div class="qty">
        <button type="button" id="qty-minus" aria-label="Decrease quantity">−</button>
        <span id="qty-value">1</span>
        <button type="button" id="qty-plus" aria-label="Increase quantity">+</button>
      </div>
      <input type="hidden" name="quantity" id="quantity" value="1">
      <button class="btn btn-block" type="submit" {% unless product.available %}disabled{% endunless %}>
        {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
      </button>
      <button class="wish wish-lg btn-ghost" type="button" data-wish="{{ product.handle }}">&#9825;</button>
    </div>
    {%- comment -%} Shopify renders Shop Pay / Apple Pay / Google Pay / PayPal here, whichever the
        shopper's device supports, once those are enabled under Settings → Payments. {%- endcomment -%}
    {%- if section.settings.show_dynamic_checkout -%}
      <div class="paynow">{{ form | payment_button }}</div>
    {%- endif -%}

    <div class="trust4">
      <div><i>📦</i><b>Free UK delivery</b><span>on orders over £{{ settings.free_shipping_threshold }}</span></div>
      <div><i>↩️</i><b>{{ settings.returns_days }}-day returns</b><span>worn or not</span></div>
      <div><i>🐱</i><b>Sized for cats</b><span>faces and eyes clear</span></div>
      {%- if product.metafields.custom.badge_uk == true -%}
        <div><i>🇬🇧</i><b>UK stock</b><span>dispatched here</span></div>
      {%- else -%}
        <div><i>🔒</i><b>Secure checkout</b><span>Shopify Payments</span></div>
      {%- endif -%}
    </div>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="payicons svg" aria-label="Payment methods accepted">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payicon' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  {%- endform -%}

  {%- comment -%} sticky add-to-cart: shown by catwalk.js once the buy box scrolls off screen {%- endcomment -%}
  <div class="sticky-atc" data-sticky-atc hidden>
    {%- if has_photos -%}<img src="{{ product.featured_image | image_url: width: 96 }}" alt="" width="48" height="48">{%- endif -%}
    <div class="s-meta"><b>{{ product.title }}</b><span class="small muted" data-s-size></span></div>
    <span class="price" data-s-price>{{ cv.price | money }}</span>
    <button class="btn btn-sm" type="button" data-s-add {% unless product.available %}disabled{% endunless %}>{{ 'products.product.add_to_cart' | t }}</button>
  </div>

  {%- if product.metafields.custom.for_me_if != blank -%}
    <section class="forme">
      <h2>This is for you if…</h2>
      <ul>{%- for t in product.metafields.custom.for_me_if.value -%}<li>{{ t }}</li>{%- endfor -%}</ul>
    </section>
  {%- endif -%}

  {%- comment -%} 4 · lifestyle videos — product media of type video / external video {%- endcomment -%}
  {%- if videos.size > 0 or ext_videos.size > 0 -%}
    <section class="videos">
      <h2>{{ section.settings.videos_heading }}</h2>
      <div class="video-grid">
        {%- for media in videos -%}
          {{ media | video_tag: controls: true, muted: true, loop: true, playsinline: true, preload: 'metadata' }}
        {%- endfor -%}
        {%- for media in ext_videos -%}
          {{ media | external_video_tag }}
        {%- endfor -%}
      </div>
    </section>
  {%- elsif request.design_mode -%}
    <section class="videos"><div class="video-slot">Lifestyle videos appear here — add video media to this product.</div></section>
  {%- endif -%}

  {%- comment -%} 5 · reviews — an app block (Judge.me, Loox) dropped in via the theme editor {%- endcomment -%}
  <section class="reviews" id="reviews">
    <h2>{% if rating_count > 0 %}{{ section.settings.reviews_heading }}{% else %}Reviews{% endif %}</h2>
    {%- if rating_count > 0 -%}
      <div class="rev-summary"><div class="score"><b>{{ rating_val | round: 1 }}</b><span class="stars has">{%- for i in (1..5) -%}{%- if i <= rating_round -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span><span class="small muted">Based on {{ rating_count }} review{% if rating_count != 1 %}s{% endif %}</span></div>
        <p class="muted" style="margin:0">What customers said after the costume went on. Every review below is verified by the reviews app.</p></div>
    {%- endif -%}
    {%- assign has_app_block = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {%- assign has_app_block = true -%}
        {% render block %}
      {%- endif -%}
    {%- endfor -%}
    {%- unless has_app_block or sup_count > 0 -%}
      <div class="panel center">
        <p style="font-size:2rem;margin:0">☆</p>
        <p><b>No reviews yet — be the first.</b></p>
        <p class="muted small" style="max-width:46ch;margin-inline:auto">Reviews appear here once customers leave them.</p>
      </div>
    {%- endunless -%}
    {%- comment -%} Reviews from the maker's listing (custom.supplier_reviews, JSON). Labelled, separate, never merged into our rating. {%- endcomment -%}
    {%- if sup_count > 0 -%}
      <div class="synd-block">
        <div class="rev-summary"><div class="score"><b>{{ sup_rating | round: 1 }}</b><span class="stars has">{%- for i in (1..5) -%}{%- if i <= sup_round -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span><span class="small muted">Based on {{ sup_count }} reviews</span></div>
          <p class="muted" style="margin:0">{{ section.settings.synd_note }}</p></div>
        <div class="rev-filter" data-rev-filter><button class="chip chip-sm" type="button" data-f="all" aria-pressed="true">All</button>{%- for k in (1..5) -%}{%- assign star = 6 | minus: k -%}<button class="chip chip-sm" type="button" data-f="{{ star }}" aria-pressed="false">{{ star }}★</button>{%- endfor -%}</div>
        {%- if sup_reviews -%}
          <div class="rev-list" data-rev-list>
            {%- for r in sup_reviews -%}
              <article class="rev synd" data-stars="{{ r.stars }}" {% if forloop.index > 6 %}data-rev-hidden hidden{% endif %}><div class="rev-head"><span class="avatar">🌍</span><div><b>{{ r.name | default: 'Verified buyer' }}</b> <span class="vtag">Verified purchase</span><span class="small muted">{{ r.date }}{% if r.country %} · {{ r.country }}{% endif %}{% if r.size != blank %} · Size {{ r.size }}{% endif %}</span></div></div>
                <p class="stars has">{%- for i in (1..5) -%}{%- if i <= r.stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</p><p>{{ r.text }}</p></article>
            {%- endfor -%}
            {%- if sup_ratings.size > 0 -%}
              <h3 class="rev-h" data-rev-hidden hidden>Ratings without a comment <span class="muted small">({{ sup_ratings.size }})</span></h3>
              <div class="rev-minis" data-rev-hidden hidden>
                {%- for r in sup_ratings -%}<div class="rev mini" data-stars="{{ r.stars }}"><span class="stars has">{%- for i in (1..5) -%}{%- if i <= r.stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span> <b>{{ r.name | default: 'Verified buyer' }}</b> <span class="small muted">{{ r.date }}{% if r.size != blank %} · Size {{ r.size }}{% endif %}</span></div>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          {%- assign hidden_count = sup_reviews.size | minus: 6 | plus: sup_ratings.size -%}
          {%- if hidden_count > 0 -%}<div class="center" style="margin-top:14px"><button class="btn btn-ghost" type="button" data-rev-more>Show all {{ sup_reviews.size | plus: sup_ratings.size }} reviews</button></div>{%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </section>

  {%- comment -%} 6 · description & dimensions {%- endcomment -%}
  <div class="details acc" id="fit">
    <details open><summary>Product details &amp; dimensions</summary><div class="inner">
    {%- if product.metafields.custom.specs != blank -%}
      <h3>What you get</h3>
      <ul class="deets">{%- for item in product.metafields.custom.specs.value -%}<li>{{ item }}</li>{%- endfor -%}</ul>
    {%- elsif product.description != blank -%}
      <h3>What you get</h3>{{ product.description }}
    {%- endif -%}

    {%- if product.metafields.custom.box != blank -%}
      <h3>In the box</h3>
      <ul class="deets">{%- for item in product.metafields.custom.box.value -%}<li>{{ item }}</li>{%- endfor -%}</ul>
    {%- endif -%}

    <h3>Dimensions &amp; fit</h3>
    {%- unless product.has_only_default_variant -%}
      <div class="tablewrap"><table>
        <thead><tr><th>Size</th><th>Neck / notes</th></tr></thead>
        <tbody>{%- for variant in product.variants -%}<tr><td class="sz">{{ variant.title }}</td><td>{{ size_notes[forloop.index0] | strip }}</td></tr>{%- endfor -%}</tbody>
      </table></div>
    {%- else -%}
      <p><b>{{ product.metafields.custom.fit }}</b></p>
    {%- endunless -%}
    <p class="small muted">Wrap a soft tape around the neck where a collar sits and add two fingers of slack — that number is the neck size. Between two sizes? Take the larger.</p>

    <h3>Materials &amp; care</h3>
    <p style="margin:0">{{ product.metafields.custom.care | default: 'Hand wash cold and air dry unless the product says otherwise.' }}</p>
    </div></details>

    <details><summary>Delivery &amp; returns</summary><div class="inner">
    <div class="tablewrap"><table>
      <thead><tr><th>Service</th><th>Estimate</th><th>Cost</th></tr></thead>
      <tbody>
        <tr><td>UK standard, tracked</td><td>2–4 working days</td><td>{{ settings.shipping_cost }}</td></tr>
        <tr><td>UK standard over £{{ settings.free_shipping_threshold }}</td><td>2–4 working days</td><td><b>Free</b></td></tr>
      </tbody>
    </table></div>
    <p style="margin:.8em 0 0">Not right? Send it back within {{ settings.returns_days }} days, worn or not.</p>
    </div></details>

    <details><summary>Is it right for my cat?</summary><div class="inner">
    <p>Built for dress-up moments — photos, parties, visits. Pop it on, get the shot, and take it off when you are done.
      Nothing here covers the face or eyes. Supervise your cat while they are wearing it.</p>
    <p style="margin:0">Not sure? Answer the three questions further down and we'll shortlist the pieces your cat will actually wear.</p>
    </div></details>
  </div>

  {%- comment -%} 7 · cross-sell: bundles this product sits in (custom.bundles), or a bundle's contents (custom.contains) {%- endcomment -%}
  {%- assign bundles = product.metafields.custom.bundles.value -%}
  {%- assign contents = product.metafields.custom.contains.value -%}
  {%- if contents.size > 0 -%}
    <section class="xsell">
      <h2>What's in it</h2>
      <div class="xgrid">
        {%- for item in contents -%}
          <a class="xcard" href="{{ item.url }}">
            {%- if item.featured_image -%}<img src="{{ item.featured_image | image_url: width: 200 }}" alt="" width="84" height="84" loading="lazy">{%- else -%}<div data-cat-art="{{ item.handle }}"></div>{%- endif -%}
            <div><b>{{ item.title }}</b><span class="muted small">Included in this bundle</span><span class="price">{{ item.price | money }}</span></div>
          </a>
        {%- endfor -%}
      </div>
    </section>
  {%- elsif bundles.size > 0 -%}
    <section class="xsell">
      <h2>Cheaper together</h2>
      <div class="xgrid">
        {%- for b in bundles -%}
          {%- assign partner = nil -%}
          {%- for c in b.metafields.custom.contains.value -%}{%- if c.id != product.id and partner == nil -%}{%- assign partner = c -%}{%- endif -%}{%- endfor -%}
          {%- assign pic = partner.featured_image | default: b.featured_image -%}
          <a class="xcard" href="{{ b.url }}">
            {%- if pic -%}<img src="{{ pic | image_url: width: 200 }}" alt="" width="84" height="84" loading="lazy">{%- else -%}<div data-cat-art="{{ b.handle }}"></div>{%- endif -%}
            <div>
              <b>{{ b.title }}</b>
              <span class="muted small">{% if partner %}Add the {{ partner.title }} as a bundle{% else %}Bundle{% endif %}</span>
              <span class="price">{{ b.price | money }}{% if b.compare_at_price > b.price %} <em class="save">Save {{ b.compare_at_price | minus: b.price | money }}</em>{% endif %}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_related -%}
    {%- assign rel = product.collections.first -%}
    {%- if rel -%}
      <section>
        <div class="sec-head"><div><h2>Goes well with</h2></div></div>
        <div class="grid-p">
          {%- assign shown = 0 -%}
          {%- for p in rel.products -%}
            {%- if p.id != product.id and shown < 4 -%}
              {% render 'product-card', product: p %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}
</div>

<script type="application/json" data-recent-product>
  { "handle": {{ product.handle | json }}, "title": {{ product.title | json }}, "url": {{ product.url | json }}, "price": {{ cv.price | money | json }},
    "image": {% if has_photos %}{{ product.featured_image | image_url: width: 600 | json }}{% else %}""{% endif %} }
</script>
<script>
  (function(){
    var form = document.getElementById("product-form"); if(!form) return;
    var select = document.getElementById("variant-select"), qty = document.getElementById("quantity"), qtyVal = document.getElementById("qty-value"), n = 1;
    form.addEventListener("click", function(e){
      var b = e.target.closest(".szbtn");
      if(b && select){
        select.value = b.dataset.variant; select.dispatchEvent(new Event("change", { bubbles: true }));
        form.querySelectorAll(".szbtn").forEach(function(x){ x.setAttribute("aria-pressed", String(x === b)); });
        var pill = document.querySelector("[data-stock-pill]"), price = document.getElementById("price"), sp = document.querySelector("[data-s-price]"), ss = document.querySelector("[data-s-size]");
        if(pill){
          var q = parseInt(b.dataset.qty, 10), low = parseInt(pill.dataset.low, 10) || 5, avail = b.dataset.available === "true";
          pill.innerHTML = "<i></i>" + (!avail ? "Out of stock" : (q > 0 && q <= low) ? "Only " + q + " left" : "In stock");
          pill.classList.toggle("out", !avail); pill.classList.toggle("low", avail && q > 0 && q <= low);
        }
        var sv = document.querySelector("[data-saved]"); if(sv){ sv.hidden = !b.dataset.saved; sv.textContent = "You've saved " + b.dataset.saved; }
        if(price && b.dataset.price){
          price.innerHTML = '<span class="now">' + b.dataset.price + '</span>' + (b.dataset.compare ? '<s>' + b.dataset.compare + '</s><em class="off">Save ' + b.dataset.pct + '%</em>' : '');
          price.classList.toggle("sale", !!b.dataset.compare);
          var ll = document.querySelector("[data-launchline]"); if(ll){ ll.hidden = !b.dataset.compare; var a = ll.querySelector("[data-ll-price]"), c = ll.querySelector("[data-ll-list]"); if(a) a.textContent = b.dataset.price; if(c) c.textContent = b.dataset.compare; }
        }
        if(sp && b.dataset.price) sp.textContent = b.dataset.price;
        if(ss) ss.textContent = "Size " + b.textContent.trim();
      }
      if(e.target.closest("#qty-plus"))  { n = Math.min(n + 1, 20); qty.value = n; qtyVal.textContent = n; }
      if(e.target.closest("#qty-minus")) { n = Math.max(n - 1, 1);  qty.value = n; qtyVal.textContent = n; }
    });
  })();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shop Pay / Apple Pay / Google Pay button", "default": true,
      "info": "Buttons appear once accelerated checkouts are enabled under Settings → Payments." },
    { "type": "text", "id": "videos_heading", "label": "Videos heading", "default": "See it on a cat" },
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true },
    { "type": "url", "id": "size_guide_url", "label": "Size guide link" },
    { "type": "text", "id": "reviews_heading", "label": "Reviews heading (once reviews exist)", "default": "Real cats, real results" },
    { "type": "textarea", "id": "synd_note", "label": "Label above reviews from the maker's listing", "default": "Reviews collected from the maker's listing for this product, shared with permission." },
    { "type": "header", "content": "Objection cards (under the gallery)" },
    { "type": "text", "id": "q1_title", "label": "Card 1 title", "default": "Will it fit my cat?" },
    { "type": "text", "id": "q1_text", "label": "Card 1 text (sized products)", "default": "Sizes are neck measurements. Two fingers of slack, and if in doubt go up." },
    { "type": "text", "id": "q2_title", "label": "Card 2 title", "default": "When will it arrive?" },
    { "type": "text", "id": "q2_text", "label": "Card 2 text", "default": "Order today: dispatched within one working day, 2–4 working days tracked. Free over £30.", "info": "The theme replaces this with real dates (e.g. 'arrives Tue 22 – Thu 24 Sept') when JavaScript is on." },
    { "type": "url", "id": "q2_url", "label": "Card 2 link" },
    { "type": "text", "id": "q3_title", "label": "Card 3 title", "default": "Is the quality good?" },
    { "type": "text", "id": "q3_text", "label": "Card 3 text (unused when metafields exist)", "default": "Photographed on real cats; the material and care line come from the product's metafields." },
    { "type": "url", "id": "q3_url", "label": "Card 3 link" },
    { "type": "text", "id": "keep_text", "label": "'Will my cat keep it on?' default answer", "default": "Nothing covers the face. Put it on, get the shot, take it off — and 30 days to return it, worn or not." },
    { "type": "header", "content": "Competition pill on the photo" },
    { "type": "text", "id": "draw_label", "label": "Pill text", "default": "Enter Cat of the Month" },
    { "type": "url", "id": "draw_url", "label": "Competition page" }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
