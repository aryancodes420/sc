<section>
  <div class="wrap two">
    <div class="finder" data-size-finder>
      <h2 style="margin-bottom:.2em">{{ section.settings.heading }}</h2>
      <p class="muted" style="margin:0">{{ section.settings.body }}</p>
      <div class="row">
        <input type="number" id="finder-chest" inputmode="decimal" min="15" max="70" step="0.5"
               placeholder="Chest in cm" aria-label="Chest girth in centimetres">
        <button class="btn btn-mint" type="button">Size me up</button>
      </div>
      <div class="out muted">Pop a chest measurement in and we'll size it.</div>
      <div class="presets"></div>
    </div>
    <div class="panel">
      <h3>{{ section.settings.panel_heading }}</h3>
      {{ section.settings.panel_body }}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Size finder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What size is your cat?" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Measure the chest at its widest, just behind the front legs. That one number decides fit better than weight or breed." },
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "🎀 Why Catwalk Club" },
    { "type": "richtext", "id": "panel_body", "label": "Panel body",
      "default": "<p><b>Sized properly.</b> Every garment is cut to a cat's shape and listed by chest girth in centimetres and inches.</p><p><b>Breakaway fastenings as standard.</b> Every collar releases under pressure.</p><p><b>Fast, free delivery.</b> Free UK delivery over £30, and 30 days to change your mind.</p>" }
  ],
  "presets": [ { "name": "Size finder" } ]
}
{% endschema %}
