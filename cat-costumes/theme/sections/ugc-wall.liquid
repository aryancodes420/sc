{%- comment -%} "Your cats, dressed": real customer photos as blocks; empty frames fill the rest. {%- endcomment -%}
<section style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }} <b>{{ section.settings.handle }}</b>{% if section.settings.draw_url != blank %} or enter <a href="{{ section.settings.draw_url }}">Cat of the Month</a>{% endif %}.</p></div>
      {%- if section.settings.draw_url != blank -%}<a class="btn btn-ghost btn-sm" href="{{ section.settings.draw_url }}">Enter this month →</a>{%- endif -%}
    </div>
    <div class="ugc-grid">
      {%- for block in section.blocks limit: 6 -%}
        <figure class="ugc" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.caption | escape }}" width="400" height="400" loading="lazy">{%- endif -%}
          <figcaption>{{ block.settings.caption }}</figcaption>
        </figure>
      {%- endfor -%}
      {%- assign empties = 6 | minus: section.blocks.size -%}
      {%- if empties > 0 -%}{%- for i in (1..empties) -%}<figure class="ugc empty"><span>🐾</span><figcaption>Your cat here</figcaption></figure>{%- endfor -%}{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Your cats, dressed",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cats, dressed" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real customers, real cats. Tag" },
    { "type": "text", "id": "handle", "label": "Social handle", "default": "@catwalkclub" },
    { "type": "url", "id": "draw_url", "label": "Cat of the Month page" }
  ],
  "blocks": [ { "type": "photo", "name": "Photo", "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Mabel · Lion Mane" }
  ] } ],
  "presets": [ { "name": "Your cats, dressed" } ]
}
{% endschema %}
