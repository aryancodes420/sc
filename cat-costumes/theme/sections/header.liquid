<header class="site">
  <div class="wrap nav">
    <a class="logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        <img class="mark" src="{{ settings.logo | image_url: width: 76 }}" alt="{{ shop.name | escape }}" width="38" height="38">
      {%- else -%}
        <img class="mark" src="{{ 'logo.svg' | asset_url }}" alt="" width="40" height="40">
      {%- endif -%}
      {{ shop.name }}
    </a>
    <nav class="links">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" {% if link.active %}class="active"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
      <a href="{{ routes.cart_url }}" class="cartlink">
        {{ 'layout.cart.title' | t }}
        <span class="count" data-cart-count {% if cart.item_count == 0 %}style="display:none"{% endif %}>{{ cart.item_count }}</span>
      </a>
    </nav>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
