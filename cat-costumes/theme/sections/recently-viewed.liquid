{%- comment -%} Rendered by catwalk.js from localStorage; product pages record what was viewed. Hidden when empty. {%- endcomment -%}
<section style="padding-top:0" data-recently-viewed data-exclude="{{ product.handle }}" hidden>
  <div class="wrap">
    <div class="sec-head"><div><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="grid-p" data-recent-grid></div>
  </div>
</section>
{% schema %}
{
  "name": "Recently viewed",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" } ],
  "presets": [ { "name": "Recently viewed" } ]
}
{% endschema %}
