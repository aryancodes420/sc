<section class="hero">
  <div class="wrap grid">
    <div>
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p class="lede">{{ section.settings.subheading }}</p>
      <div class="cta">
        {%- if section.settings.button_1_label != blank -%}
          <a class="btn" href="{{ section.settings.button_1_url | default: routes.all_products_collection_url }}">{{ section.settings.button_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.button_2_url }}">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="heroart">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="900" height="900" loading="eager">
      {%- else -%}
        <div data-cat-art="hero-lion" data-art-motif="mane"></div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "🎃 Halloween is in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Costumes your cat will look unfairly good in." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pumpkins, dinosaurs, tiny jumpers and one magnificent lion mane — every piece cut to a cat's shape, in sizes that actually fit." },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Falls back to an illustration when empty." },
    { "type": "text", "id": "button_1_label", "label": "Primary button", "default": "Shop all costumes" },
    { "type": "url", "id": "button_1_url", "label": "Primary link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button", "default": "Find their size" },
    { "type": "url", "id": "button_2_url", "label": "Secondary link" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
