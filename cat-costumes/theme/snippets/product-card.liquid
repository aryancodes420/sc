{%- comment -%}
  Product card. Falls back to an illustration when a product has no photograph,
  so the grid never renders as empty placeholder boxes.
  Params: product
{%- endcomment -%}
{%- assign motif = product.metafields.custom.motif | default: '' -%}
<div class="pcard-wrap" style="position:relative">
  <a class="pcard" href="{{ product.url }}">
    {%- if product.metafields.custom.badge != blank -%}
      <span class="badge{% if product.metafields.custom.contains.value.size > 0 %} save{% endif %}">{{ product.metafields.custom.badge }}</span>
    {%- endif -%}

    <div class="art">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             width="600" height="600" loading="lazy">
        {%- if product.images[1] -%}<img class="alt" src="{{ product.images[1] | image_url: width: 600 }}" alt="" width="600" height="600" loading="lazy">{%- endif -%}
      {%- else -%}
        <div data-cat-art="{{ product.handle }}" data-art-motif="{{ motif }}"></div>
      {%- endif -%}
    </div>

    <div class="body">
      <h3>{{ product.title }}</h3>
      {%- assign rc = product.metafields.reviews.rating_count.value | default: 0 -%}
      {%- assign rv = product.metafields.reviews.rating.value.rating | default: 0 | times: 1.0 -%}
      {%- if rc == 0 -%}{%- assign rc = product.metafields.custom.supplier_review_count | default: 0 | times: 1 -%}{%- assign rv = product.metafields.custom.supplier_rating | default: 0 | times: 1.0 -%}{%- endif -%}
      {%- if rc > 0 -%}{%- assign rr = rv | round -%}<span class="card-rating"><span class="stars has" aria-hidden="true">{%- for i in (1..5) -%}{%- if i <= rr -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span> {{ rv | round: 1 }} <span class="muted">({{ rc }})</span></span>{%- endif -%}
      <p class="blurb">{{ product.description | strip_html | truncatewords: 16 }}</p>
      {%- if product.compare_at_price > product.price -%}
        {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="price sale"><span class="now">{{ product.price | money }}</span><s>{{ product.compare_at_price | money }}</s><em class="off">Save {{ pct }}%</em></span>
      {%- else -%}
        <span class="price">{{ product.price | money }}</span>
      {%- endif -%}
    </div>
  </a>
  <button class="wish" type="button" data-wish="{{ product.handle }}" aria-pressed="false" aria-label="Save to wishlist">&#9825;</button>
  {%- comment -%} quick add: one-size products go straight in; sized ones open the size picker; sold out asks to be notified {%- endcomment -%}
  {%- if product.available == false -%}
    <a class="qadd notify" href="{{ settings.contact_page | default: '/pages/contact' }}?product={{ product.handle }}">🔔 Notify</a>
  {%- elsif product.has_only_default_variant -%}
    {%- form 'product', product, class: 'qadd-form' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button class="qadd" type="submit">🛒 {{ 'products.product.add_to_cart' | t | split: ' ' | first }}</button>
    {%- endform -%}
  {%- else -%}
    <a class="qadd" href="{{ product.url }}#product-form">Pick size</a>
  {%- endif -%}
</div>
