{%- comment -%}
  JSON-LD for search engines. Organization on every page; Product + BreadcrumbList on
  product pages. aggregateRating is only emitted when a reviews app has written real
  numbers to the standard reviews.rating / reviews.rating_count metafields.
{%- endcomment -%}
{%- assign ship_cost = settings.shipping_cost | remove: '£' | default: '0' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  {%- if settings.trader_name != blank -%}"legalName": {{ settings.trader_name | json }},{%- endif -%}
  {%- if settings.trader_address != blank -%}"address": { "@type": "PostalAddress", "streetAddress": {{ settings.trader_address | json }}, "addressCountry": "GB" },{%- endif -%}
  {%- if settings.logo != blank -%}"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{%- endif -%}
  {%- if settings.contact_email != blank -%}"email": {{ settings.contact_email | json }},{%- endif -%}
  "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "areaServed": "GB", "availableLanguage": "en"
    {%- if settings.contact_email != blank -%}, "email": {{ settings.contact_email | json }}{%- endif -%} }
}
</script>
{%- if template.name == 'product' and product -%}
  {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | default: product.handle | json }},
    "description": {{ product.description | strip_html | strip_newlines | json }},
    "image": [{%- for image in product.images limit: 6 -%}{{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    {%- if rating_count > 0 -%}
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }}, "reviewCount": {{ rating_count | json }} },
    {%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "url": {{ shop.url | append: variant.url | json }},
        "sku": {{ variant.sku | default: product.handle | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
        "shippingDetails": { "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": {{ ship_cost | json }}, "currency": {{ cart.currency.iso_code | json }} },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "GB" },
          "deliveryTime": { "@type": "ShippingDeliveryTime", "transitTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 4, "unitCode": "DAY" } } },
        "hasMerchantReturnPolicy": { "@type": "MerchantReturnPolicy", "applicableCountry": "GB",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": {{ settings.returns_days | default: 30 | json }}, "returnMethod": "https://schema.org/ReturnByMail", "returnFees": {% if settings.returns_free_postage %}"https://schema.org/FreeReturn"{% else %}"https://schema.org/ReturnFeesCustomerResponsibility"{% endif %} }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
      {%- assign crumb = collection | default: product.collections.first -%}
      {%- if crumb -%}{ "@type": "ListItem", "position": 2, "name": {{ crumb.title | json }}, "item": {{ shop.url | append: crumb.url | json }} },{%- endif -%}
      { "@type": "ListItem", "position": {% if crumb %}3{% else %}2{% endif %}, "name": {{ product.title | json }} }
    ]
  }
  </script>
{%- endif -%}
